---
/*
 * Giant-serif numeral band: one dominant stat set in the display serif
 * (.stat-numeral, the only serif use here), with the remaining three stats
 * as a modest hairline-separated mono row underneath.
 *
 * Numbers are defensible, not fabricated: the 500+ course count spans both
 * encoded catalogues (owner-stated 2026-08-16, TU Delft Aerospace live + the
 * TU Munich pilot); "< 2 wks" is the observed setup time (kept short so it
 * never wraps). Institutions are named on owner instruction (2026-08-16, the
 * TU Munich pilot is part of the pitch). Reveal only, no count-up.
 */
const hero = {
  value: "500+",
  label: "Courses available",
  note: "TU Delft Aerospace live + the TU Munich pilot catalogue",
};
const supporting = [
  { value: "2", label: "University catalogues", note: "TU Delft live, TU Munich pilot encoded" },
  { value: "5", label: "Specialisation tracks", note: "prerequisites and EC rules per track" },
  { value: "< 2 wks", label: "From guide to live", note: "programme guide to working planner" },
];
---

<section class="border-y border-line bg-paper-shade py-[var(--section-y)]">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="sr-only">By the numbers</h2>

    <!-- Numeral and caption are one text unit: value, label, note read in sequence. -->
    <p data-reveal class="text-center">
      <span class="stat-numeral block text-[length:var(--text-stat)] leading-none text-ink">
        {hero.value}
      </span>
      <span class="mt-5 block font-mono text-[0.95rem] tracking-[0.02em] text-muted">
        {hero.label}
      </span>
      <span class="mt-1 block font-mono text-[0.8rem] text-muted">{hero.note}</span>
    </p>

    <dl
      data-reveal
      class="mx-auto mt-[clamp(3rem,2rem+3.5vw,5rem)] grid max-w-4xl grid-cols-1 gap-y-8 border-t border-line pt-8 sm:grid-cols-3 sm:gap-y-0"
    >
      {
        supporting.map((s, i) => (
          <div
            class:list={[
              "text-center sm:px-[clamp(1rem,2vw,1.75rem)]",
              i !== 0 && "border-t border-line pt-8 sm:border-t-0 sm:border-l sm:pt-0",
            ]}
          >
            <dt class="font-mono text-[1.3rem] font-medium tracking-[-0.02em] text-accent-deep tabular-nums">
              {s.value}
            </dt>
            <dd class="mt-2 text-[0.92rem] leading-snug text-muted">{s.label}</dd>
            <dd class="mt-1 text-[0.82rem] leading-snug text-muted">{s.note}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
