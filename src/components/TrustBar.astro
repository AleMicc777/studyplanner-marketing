---
/*
 * Trust strip directly under the hero. No logo wall: four factual, defensible
 * mono credentials on a single hairline-bounded panel line, each led by an amber
 * tick. Reads as "this is real and deployed" without naming any institution.
 */
const credentials = [
  { lead: "Live MSc Aerospace planner", rest: "" },
  { lead: "180+", rest: " courses encoded" },
  { lead: "Live EC validation", rest: "" },
  { lead: "EU-hosted", rest: ", GDPR-ready" },
];
---

<section class="trust" aria-label="At a glance">
  <div class="mx-auto max-w-6xl px-6">
    <div class="trust-inner">
      {credentials.map((c) => (
        <div class="trust-item">
          <span class="tick" aria-hidden="true">&#10003;</span>
          <span><b>{c.lead}</b>{c.rest}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--color-panel);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }
  .trust-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.15rem clamp(0.75rem, 2vw, 1.5rem);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: -0.01em;
    color: var(--color-on-dark-2);
    border-left: 1px solid var(--color-hairline);
  }
  .trust-item:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .trust-item .tick {
    color: var(--color-amber);
    flex: none;
  }
  .trust-item b {
    color: var(--color-on-dark);
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .trust-inner {
      grid-template-columns: 1fr 1fr;
    }
    .trust-item {
      border-top: 1px solid var(--color-hairline);
    }
    .trust-item:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .trust-item:nth-child(1),
    .trust-item:nth-child(2) {
      border-top: 0;
    }
  }

  @media (max-width: 560px) {
    .trust-inner {
      grid-template-columns: 1fr;
    }
    .trust-item {
      border-left: 0 !important;
      padding-left: 0;
      border-top: 1px solid var(--color-hairline);
    }
    .trust-item:first-child {
      border-top: 0;
    }
  }
</style>
