---
interface Props {
  href: string;
  variant?: "solid" | "solid-dark" | "outline" | "outline-invert";
  dataTrack?: string;
  target?: string;
  rel?: string;
  class?: string;
}

const { href, variant = "solid", dataTrack, target, rel, class: className } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 text-[0.95rem] font-semibold tracking-tight transition-colors duration-200 active:translate-y-px border";

// Primary action — the amber signal. Works on graphite and on paper.
// `solid` and `solid-dark` are the same amber primary; the two names document
// intent at the call site (which background the button sits on).
const amberPrimary =
  "bg-amber text-graphite border-amber hover:bg-amber-hover hover:border-amber-hover";

const variants = {
  solid: amberPrimary,
  "solid-dark": amberPrimary,
  // Ghost on dark (graphite) surfaces.
  outline: "bg-transparent text-on-dark border-hairline hover:border-amber hover:text-amber",
  // Ghost on light (paper) surfaces.
  "outline-invert":
    "bg-transparent text-ink border-line hover:border-amber hover:text-amber-deep",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  data-track={dataTrack}
  class:list={[base, variants[variant], className]}
>
  <slot />
</a>
