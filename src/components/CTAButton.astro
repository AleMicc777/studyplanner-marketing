---
interface Props {
  href: string;
  variant?: "solid" | "solid-dark" | "outline" | "outline-invert";
  dataTrack?: string;
  target?: string;
  rel?: string;
  class?: string;
}

const { href, variant = "solid", dataTrack, target, rel, class: className } = Astro.props;

const base =
  "pressable inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-[0.95rem] font-semibold tracking-tight border";

// Primary action — the accent signal. Works on graphite and on paper.
// `solid` and `solid-dark` are the same accent primary; the two names document
// intent at the call site (which background the button sits on).
const accentPrimary =
  "bg-accent text-graphite-2 border-accent hover:bg-accent-hover hover:border-accent-hover";

const variants = {
  solid: accentPrimary,
  "solid-dark": accentPrimary,
  // Ghost on dark (graphite) surfaces.
  outline: "bg-transparent text-on-dark border-hairline hover:border-accent hover:text-accent",
  // Ghost on light (paper) surfaces.
  "outline-invert":
    "bg-transparent text-ink border-line hover:border-accent hover:text-accent-deep",
};
---

<a
  href={href}
  target={target}
  rel={rel}
  data-track={dataTrack}
  class:list={[base, variants[variant], className]}
>
  <slot />
</a>
