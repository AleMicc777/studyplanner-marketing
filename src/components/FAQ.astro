---
import { faqs } from "../data/faqs";
---

<section class="border-b border-ink-200 bg-paper">
  <div class="mx-auto max-w-3xl px-6 py-[var(--section-y)]">
    <h2 data-reveal class="text-[length:var(--text-h2)] font-semibold text-[color:var(--color-text)]">
      Common questions
    </h2>
    <dl class="mt-10 divide-y divide-ink-200 border-t border-b border-ink-200">
      {faqs.map((item) => (
        <details class="group">
          <summary
            data-track="faq-open"
            class="flex cursor-pointer items-center justify-between gap-4 py-5 font-[family-name:var(--font-heading)] text-base font-semibold text-[color:var(--color-text)] marker:hidden [&::-webkit-details-marker]:hidden"
          >
            {item.q}
            <span class="shrink-0 text-[color:var(--color-text-muted)] transition group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="pb-5 font-[family-name:var(--font-body)] text-[color:var(--color-text-muted)]">
            {item.a}
          </div>
        </details>
      ))}
    </dl>
  </div>
</section>
