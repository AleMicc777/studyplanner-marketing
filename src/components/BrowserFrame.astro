---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  decoding?: "sync" | "async";
  fetchpriority?: "high" | "low" | "auto";
}
const {
  src,
  alt,
  caption,
  width = 1440,
  height = 900,
  loading = "lazy",
  decoding = "async",
  fetchpriority = "auto",
} = Astro.props;
---

<figure class="m-0">
  <div class="border border-ink-200 bg-paper">
    <div class="flex items-center gap-1.5 border-b border-ink-200 bg-ink-200/40 px-3 py-2">
      <span class="h-2 w-2 rounded-full bg-ink-200"></span>
      <span class="h-2 w-2 rounded-full bg-ink-200"></span>
      <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    </div>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      class="block w-full"
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
    />
  </div>
  {caption && (
    <figcaption class="mt-3 text-sm text-[var(--color-text-muted)]">{caption}</figcaption>
  )}
</figure>
