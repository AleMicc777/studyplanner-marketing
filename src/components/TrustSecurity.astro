---
import { CONTACT_EMAIL } from "../config/site";
import InkLedgerBook from "./ink/InkLedgerBook.astro";

const points = [
  {
    title: "Where plan data lives",
    body: "Study plans and account records are stored in Neon Postgres in eu-central-1, Frankfurt. Plans sync as the student edits them, so a coordinator always reads the current version rather than an emailed copy.",
  },
  {
    title: "An account is required",
    body: "Students sign in before using the planner; there is no anonymous mode. Authentication runs through Clerk in its EU data region. Coordinators and administrators sign in the same way.",
  },
  {
    title: "What we store about a person",
    body: "Two fields: the name and email address on the account. No student number, no address, no date of birth, no grades. The rest of the record is the study plan itself.",
  },
  {
    title: "Sub-processors, in full",
    body: "Vercel (hosting), Neon (database, Frankfurt), Clerk (authentication, EU data region), PostHog (product analytics, EU cloud), Sentry (error reporting), Upstash (rate limiting), Resend (transactional email), Google Gemini (AI assistance). Sentry, Upstash, Resend and Gemini are not currently pinned to an EU region — we will confirm the position for each in writing during review.",
  },
  {
    title: "Never used for training or sold",
    body: "Plan and account data is not used to train models, not sold, and not shared with advertisers. Gemini is called for assistance features only and is not sent personal identifiers.",
  },
  {
    title: "DPA and deletion",
    body: "We draft a Data Processing Agreement per institution rather than publishing a standing one; ask and we will send yours. Any account and its plans can be deleted in full on request.",
  },
];
---

<section class="border-b border-line bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <div class="flex flex-col items-start gap-8 sm:flex-row sm:justify-between sm:gap-10">
      <div>
        <h2 data-reveal class="max-w-[22ch] serif-heading text-[length:var(--text-h2)] text-ink">
          Built for GDPR procurement, not around it
        </h2>
        <p class="mt-4 max-w-[var(--prose-max)] text-[length:var(--text-lead)] leading-relaxed text-muted">
          University data-protection review is part of every pilot, not an afterthought. Here is
          what we can tell your data protection officer before they ask.
        </p>
      </div>

      <div data-reveal class="aspect-square w-[130px] shrink-0 sm:w-[200px] lg:w-[220px]">
        <InkLedgerBook />
      </div>
    </div>

    <dl class="mt-12 divide-y divide-line border-t border-line">
      {points.map((p) => (
        <div class="grid gap-2 py-6 sm:grid-cols-[16rem_1fr] sm:gap-8">
          <dt class="flex items-start gap-2.5 font-semibold text-ink">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[1px] bg-accent"></span>
            {p.title}
          </dt>
          <dd class="max-w-[70ch] leading-relaxed text-muted sm:pl-0">{p.body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-8 text-sm text-muted">
      Questions for your DPO? Reach us directly at
      {" "}
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="font-medium text-cobalt-ink underline decoration-cobalt-ink/40 underline-offset-4 transition-colors hover:text-cobalt-bright"
      >
        {CONTACT_EMAIL}
      </a>.
    </p>
    <p class="mt-3 text-sm">
      <a
        href={`mailto:${CONTACT_EMAIL}?subject=DPA%20request`}
        class="font-medium text-cobalt-ink underline decoration-cobalt-ink/40 underline-offset-4 transition-colors hover:text-cobalt-bright"
      >
        Request the DPA <span aria-hidden="true">&rarr;</span>
      </a>
    </p>
  </div>
</section>
