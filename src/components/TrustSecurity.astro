---
import { CONTACT_EMAIL } from "../config/site";

const points = [
  {
    title: "EU hosting",
    body: "All infrastructure runs on EU-based hosting. Shared plan data never leaves the EU.",
  },
  {
    title: "No student accounts required",
    body: "Students can build and validate a full plan without creating an account. Advisors can view a shared plan without either party signing up.",
  },
  {
    title: "Data minimisation",
    body: "Plans are stored locally in the student's browser by default. Nothing reaches our servers unless a student explicitly chooses to share.",
  },
  {
    title: "No third-party tracking cookies",
    body: "Fonts are self-hosted and analytics are cookieless, so the site loads without a cookie banner and without sending visitor data to Google or Meta.",
  },
  {
    title: "DPA available on request",
    body: "A Data Processing Agreement is ready for your institution's procurement process. Ask in the first call.",
  },
  {
    title: "Data deletion on request",
    body: "Any shared plan or account can be deleted on request, in full, within the timelines your institution requires.",
  },
];
---

<section class="border-b border-line bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2 data-reveal class="max-w-[22ch] text-[length:var(--text-h2)] font-extrabold tracking-[-0.04em] text-ink">
      Built for GDPR procurement, not around it
    </h2>
    <p class="mt-4 max-w-[var(--prose-max)] text-[length:var(--text-lead)] leading-relaxed text-muted">
      University data-protection review is part of every pilot, not an afterthought. Here is
      what we can tell your data protection officer before they ask.
    </p>

    <dl class="mt-12 divide-y divide-line border-t border-line">
      {points.map((p) => (
        <div class="grid gap-2 py-6 sm:grid-cols-[16rem_1fr] sm:gap-8">
          <dt class="flex items-start gap-2.5 font-semibold text-ink">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-[1px] bg-amber"></span>
            {p.title}
          </dt>
          <dd class="leading-relaxed text-muted sm:pl-0">{p.body}</dd>
        </div>
      ))}
    </dl>

    <p class="mt-8 text-sm text-muted">
      Questions for your DPO? Reach us directly at
      {" "}
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="font-medium text-amber-deep underline decoration-amber-line/40 underline-offset-4 transition-colors hover:text-amber-hover"
      >
        {CONTACT_EMAIL}
      </a>.
    </p>
  </div>
</section>
