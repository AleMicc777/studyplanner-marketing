---
// Light product-echo card: declared abstraction of the coordinator review
// queue. Monogram discs use neutral non-name initials; status is text, never
// a colored dot. Joins [data-reveal] via the spread attribute or a parent.
const rows = [
  { initial: "A", width: "58%", status: "valid", tone: "text-valid-deep" },
  { initial: "B", width: "44%", status: "1 flag", tone: "text-flag-deep" },
  { initial: "C", width: "66%", status: "valid", tone: "text-valid-deep" },
];
const { class: className = "", ...rest } = Astro.props;
---

<div
  class:list={[
    "w-full max-w-[300px] rounded-[10px] border border-line bg-paper p-4 shadow-(--shadow-float)",
    className,
  ]}
  role="img"
  aria-label="Illustration: review queue, two valid plans and one flagged"
  {...rest}
>
  <div aria-hidden="true">
    <p class="border-b border-line pb-2.5 font-mono text-[0.8rem] font-medium text-ink">
      Review queue
    </p>

    <div class="mt-3 space-y-2.5">
      {rows.map((row) => (
        <div class="flex items-center gap-3">
          <span
            class="flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-cobalt font-mono text-[0.7rem] leading-none text-on-dark"
          >
            {row.initial}
          </span>
          <div class="h-1.5 rounded-[3px] bg-line" style={`width:${row.width}`}></div>
          <span class={`ml-auto font-mono text-[0.8rem] ${row.tone}`}>{row.status}</span>
        </div>
      ))}
    </div>
  </div>
</div>
