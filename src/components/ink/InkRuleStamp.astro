---
const { class: className } = Astro.props;
---
<svg
  viewBox="0 0 96 96"
  width="100%"
  height="100%"
  fill="none"
  role="img"
  aria-label="Rubber stamp lifted above the checkmark it just stamped"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- accent pop: the stamped checkmark (the one teal shape) -->
  <path
    fill="var(--color-accent)"
    d="M39 70.5 L42 67.5 L45 70.6 L54.5 60.5 L57.5 63.3 L45 76.5 Z"
  />
  <g
    stroke="var(--color-ink)"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- knob handle -->
    <circle vector-effect="non-scaling-stroke" cx="48" cy="12" r="5.5" />
    <!-- tapered neck -->
    <path vector-effect="non-scaling-stroke" d="M45.5 17 L42.5 27" />
    <path vector-effect="non-scaling-stroke" d="M50.5 17 L53.5 27" />
    <!-- stamp body -->
    <rect vector-effect="non-scaling-stroke" x="36" y="27" width="24" height="10" rx="2" />
    <!-- wide base plate, lifted after the press -->
    <rect vector-effect="non-scaling-stroke" x="30" y="37" width="36" height="8" rx="2" />
    <!-- press-motion ticks either side of the plate -->
    <path vector-effect="non-scaling-stroke" d="M24 34 V42" />
    <path vector-effect="non-scaling-stroke" d="M72 34 V42" />
    <!-- the imprint frame left on the sheet, check inside -->
    <rect vector-effect="non-scaling-stroke" x="33" y="56" width="30" height="28" rx="5" />
  </g>
</svg>
