---
const { class: className } = Astro.props;
---
<svg
  viewBox="0 0 96 96"
  width="100%"
  height="100%"
  fill="none"
  role="img"
  aria-label="Rule stamp pressing a checkmark onto a sheet"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- accent pop: the stamped checkmark, under the ink linework -->
  <path fill="var(--color-accent)" d="M37 69.5 L40 66.5 L44 70.4 L53.5 60 L56.4 62.6 L44.2 75.6 Z" />
  <g
    stroke="var(--color-ink)"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- handle knob -->
    <rect vector-effect="non-scaling-stroke" x="40" y="8" width="12" height="8" rx="2" />
    <!-- stem -->
    <path vector-effect="non-scaling-stroke" d="M44 16 V24" />
    <path vector-effect="non-scaling-stroke" d="M48 16 V24" />
    <!-- stamp body -->
    <rect vector-effect="non-scaling-stroke" x="32" y="24" width="28" height="12" rx="2" />
    <!-- die plate, mid-press -->
    <rect vector-effect="non-scaling-stroke" x="29" y="36" width="38" height="7" rx="2" />
    <!-- press-motion ticks -->
    <path vector-effect="non-scaling-stroke" d="M24 30 V38" />
    <path vector-effect="non-scaling-stroke" d="M72 30 V38" />
    <!-- sheet corner receiving the imprint -->
    <path vector-effect="non-scaling-stroke" d="M18 56 H68 Q70 56 70 58 V86" />
  </g>
</svg>
