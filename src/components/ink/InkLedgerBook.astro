---
const { class: className } = Astro.props;
---
<svg
  viewBox="0 0 96 96"
  width="100%"
  height="100%"
  fill="none"
  role="img"
  aria-label="Closed ledger book with clasp and bookmark"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- accent pop: bookmark ribbon, tucked under the bottom board -->
  <path fill="var(--color-accent)" d="M40 78 H47 L48.7 87 L44.2 84.2 L39.8 87.6 Z" />
  <g
    stroke="var(--color-ink)"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- spine band with hinge -->
    <path vector-effect="non-scaling-stroke" d="M28 14 H22 Q20 14 20 16 V78 Q20 80 22 80 H28" />
    <path vector-effect="non-scaling-stroke" d="M28 14 V80" />
    <!-- raised spine bands + stitch ticks -->
    <path vector-effect="non-scaling-stroke" d="M20 26 H28" />
    <path vector-effect="non-scaling-stroke" d="M20 66 H28" />
    <path vector-effect="non-scaling-stroke" d="M23 42 H25" />
    <path vector-effect="non-scaling-stroke" d="M23 50 H25" />
    <!-- front board -->
    <path vector-effect="non-scaling-stroke" d="M28 14 H74 Q76 14 76 16 V78 Q76 80 74 80 H28" />
    <!-- page block at the fore-edge -->
    <path vector-effect="non-scaling-stroke" d="M72 18 V76" />
    <!-- title plate with abstract label stroke -->
    <rect vector-effect="non-scaling-stroke" x="34" y="22" width="26" height="12" rx="2" />
    <path vector-effect="non-scaling-stroke" d="M38 28 H50" />
    <!-- lock clasp: plate, keyhole, wrap strap over the fore-edge -->
    <rect vector-effect="non-scaling-stroke" x="64" y="42" width="14" height="12" rx="2" />
    <circle vector-effect="non-scaling-stroke" cx="71" cy="46.5" r="1.6" />
    <path vector-effect="non-scaling-stroke" d="M71 48.1 V50.5" />
    <path vector-effect="non-scaling-stroke" d="M78 45 Q82 45 82 48 Q82 51 78 51" />
    <!-- ledger rules on the lower board -->
    <path vector-effect="non-scaling-stroke" d="M34 64 H66" />
    <path vector-effect="non-scaling-stroke" d="M34 69 H54" />
  </g>
</svg>
