---
const { class: className } = Astro.props;
---
<svg
  viewBox="0 0 96 96"
  width="100%"
  height="100%"
  fill="none"
  role="img"
  aria-label="Programme guide document being posted in an envelope"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <g
    stroke="var(--color-ink)"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- the guide sheet, half posted -->
    <rect vector-effect="non-scaling-stroke" x="31" y="14" width="34" height="34" rx="2" />
    <path vector-effect="non-scaling-stroke" d="M38 23 H58" />
    <path vector-effect="non-scaling-stroke" d="M38 29 H58" />
    <path vector-effect="non-scaling-stroke" d="M38 35 H51" />
    <!-- envelope body occludes the sheet's lower half -->
    <rect
      vector-effect="non-scaling-stroke"
      x="17"
      y="45"
      width="62"
      height="32"
      rx="2"
      fill="var(--color-paper)"
    />
    <!-- envelope fold -->
    <path vector-effect="non-scaling-stroke" d="M17 45 L48 63 L79 45" />
  </g>
  <!-- accent pop: the teal postage stamp (the one teal shape) -->
  <rect fill="var(--color-accent)" x="64" y="66" width="9" height="7" rx="1.5" />
</svg>
