---
const flagship = [
  {
    title: "Real-time EC validation",
    body: "Live credit totals with instant flags for shortfalls, overloads, and prerequisite violations — checked on every edit, not at submission.",
    image: "/screenshots/screenshot-2.png",
  },
  {
    title: "Advisor share links",
    body: "One shareable URL per plan — no account needed for the advisor to view or comment. No PDF export, no back-and-forth email.",
    image: "/screenshots/screenshot-3.png",
  },
];

const compact = [
  { title: "Guided setup", body: "Programme, track, and sub-track selection pre-loads the right mandatory courses automatically." },
  { title: "AI course recommendations", body: "Personalised elective suggestions based on the student's profile and the full course catalogue." },
  { title: "A/B plan comparison", body: "Students can build and compare two plan variants side-by-side before committing." },
  { title: "Multi-university ready", body: "Each institution gets its own branded subdomain, catalogue, and rules. No shared state." },
];
---

<section class="border-b border-ink-200 bg-paper-shade">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2 data-reveal class="font-heading text-[var(--text-h2)] font-semibold text-ink-950">What's included</h2>
    <p class="mt-4 max-w-xl text-[var(--color-text-muted)]">
      Everything a student needs to build a valid plan. Everything a coordinator needs to stop reviewing them manually.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {flagship.map((f) => (
        <div class="border border-ink-200 bg-paper">
          <div class="border-b border-ink-200">
            <img src={f.image} alt={f.title} width="1200" height="750" loading="lazy" class="block w-full h-auto" />
          </div>
          <div class="p-6">
            <h3 class="font-heading text-[var(--text-h3)] font-semibold text-ink-950">{f.title}</h3>
            <p class="mt-2 text-[var(--color-text-muted)]">{f.body}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-6 divide-y divide-ink-200 border border-ink-200 bg-paper sm:grid sm:grid-cols-2 sm:divide-y-0 sm:[&>*:nth-child(odd)]:border-r sm:[&>*:nth-child(n+3)]:border-t sm:[&>*]:border-ink-200">
      {compact.map((f) => (
        <div class="p-6">
          <h3 class="font-heading font-semibold text-ink-950">{f.title}</h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
