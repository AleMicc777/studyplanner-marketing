---
import BrowserFrame from "./BrowserFrame.astro";

const flagship = [
  {
    tag: "real-time",
    title: "Real-time EC validation",
    body: "Live credit totals with instant flags for shortfalls, overloads, and prerequisite violations. Checked on every edit, not at submission.",
    points: [
      "Per-quarter and total EC counts, always current",
      "Prerequisite chains checked as courses are added",
      "Overload and shortfall flags surface immediately",
    ],
    image: "/screenshots/screenshot-2.png",
    url: "planner.studyplanner.eu/validate",
    alt: "Track selection screen with live EC totals and prerequisite flags validating in real time.",
  },
  {
    tag: "sharing",
    title: "Advisor share links",
    body: "One shareable URL per plan. No account needed for the advisor to view or comment. No PDF export, no back-and-forth email.",
    points: [
      "One link per plan, ready to send",
      "No advisor login or account required",
      "Comment in place instead of over email",
    ],
    image: "/screenshots/screenshot-3.png",
    url: "planner.studyplanner.eu/plan/share",
    alt: "Full study plan grid opened from a share link, viewable without an account.",
  },
];

const compact = [
  { title: "Guided setup", body: "Programme, track, and sub-track selection pre-loads the right mandatory courses automatically." },
  { title: "AI course recommendations", body: "Personalised elective suggestions based on the student's profile and the full course catalogue." },
  { title: "A/B plan comparison", body: "Students can build and compare two plan variants side-by-side before committing." },
  { title: "Multi-university ready", body: "Each institution gets its own branded subdomain, catalogue, and rules. No shared state." },
];
---

<section class="border-b border-line bg-paper-shade text-ink">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2 data-reveal class="max-w-2xl text-[length:var(--text-h2)] font-extrabold tracking-[-0.04em] text-ink">
      What's included
    </h2>
    <p class="mt-4 max-w-xl text-[length:var(--text-lead)] text-muted">
      Everything a student needs to build a valid plan. Everything a coordinator needs to stop reviewing them manually.
    </p>

    <!-- Flagship rows: editorial, screenshot alternates side each row. -->
    <div class="mt-16 space-y-16 lg:space-y-24">
      {flagship.map((f, i) => (
        <div data-reveal class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
          <div class:list={["min-w-0 max-w-lg", i % 2 === 1 && "lg:order-2"]}>
            <p class="font-mono text-xs tracking-[0.02em] text-amber-deep">// {f.tag}</p>
            <h3 class="mt-3 text-[length:var(--text-h3)] font-semibold tracking-[-0.02em] text-ink">
              {f.title}
            </h3>
            <p class="mt-4 text-muted">{f.body}</p>
            <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
              {f.points.map((pt) => (
                <li class="flex items-start gap-2.5 text-sm text-ink">
                  <span class="mt-px shrink-0 font-mono text-amber-deep" aria-hidden="true">&#10003;</span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
          <div class:list={["min-w-0", i % 2 === 1 && "lg:order-1"]}>
            <BrowserFrame
              src={f.image}
              alt={f.alt}
              tone="light"
              url={f.url}
              live={true}
              width={1440}
              height={900}
            />
          </div>
        </div>
      ))}
    </div>

    <!-- Ledger grid: compact, hairline-ruled checklist. Distinct from the flagship rows. -->
    <p class="mt-16 font-mono text-xs tracking-[0.02em] text-muted">// also included</p>
    <div
      data-reveal
      class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
    >
      {compact.map((f) => (
        <div class="bg-paper p-6">
          <span class="font-mono text-sm text-amber-deep" aria-hidden="true">&#10003;</span>
          <h3 class="mt-3 font-semibold tracking-[-0.01em] text-ink">{f.title}</h3>
          <p class="mt-2 text-sm text-muted">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
