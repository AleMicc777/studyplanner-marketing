---
// Light product-echo card: declared abstraction of the EC progress counter.
// Skeleton bars stand in for course names; only real product numbers render.
// Joins [data-reveal] via the spread attribute or a wrapping parent.
const rows = [
  { width: "62%", ec: "6 EC" },
  { width: "45%", ec: "12 EC" },
  { width: "55%", ec: "6 EC" },
];
const { class: className = "", ...rest } = Astro.props;
---

<div
  class:list={[
    "w-full max-w-[300px] rounded-[10px] border border-line bg-paper p-4 shadow-(--shadow-float)",
    className,
  ]}
  role="img"
  aria-label="Illustration: degree progress counter, 96 of 120 EC planned"
  {...rest}
>
  <div aria-hidden="true" class="font-mono text-[0.8rem] leading-normal">
    <p class="font-medium text-ink">96 / 120 EC planned</p>

    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-line">
      <div class="h-full w-[80%] rounded-full bg-accent"></div>
    </div>

    <div class="mt-4 space-y-2.5">
      {rows.map((row) => (
        <div class="flex items-center gap-3">
          <div class="h-1.5 rounded-[3px] bg-line" style={`width:${row.width}`}></div>
          <span class="ml-auto text-muted">{row.ec}</span>
        </div>
      ))}
    </div>
  </div>
</div>
