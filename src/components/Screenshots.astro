---
import BrowserFrame from "./BrowserFrame.astro";
import { PLANNER_URL } from "../config/site";

const screens = [
  {
    src: "/screenshots/screenshot-1.png",
    alt: "StudyPlanner onboarding — MSc Aerospace Engineering landing page",
    title: "Branded per institution",
    caption: "Students land on a programme-specific page. The planner loads the right catalogue, tracks, and rules automatically — no configuration needed on the student side.",
    width: 1440,
    height: 900,
  },
  {
    src: "/screenshots/screenshot-2.png",
    alt: "Track selection — choose your specialisation",
    title: "Pick track and profile",
    caption: "Step 1: the student picks their specialisation. Mandatory courses pre-load instantly. The profile panel on the right shows sub-tracks to narrow elective recommendations.",
    width: 1440,
    height: 900,
  },
  {
    src: "/screenshots/screenshot-3.png",
    alt: "Full study plan grid with validation and AI recommendations",
    title: "Full plan — live validation + AI",
    caption: "The plan view: four quarters per year, real-time EC totals, prerequisite conflict flags, workload indicators, and an AI recommendation panel that analyses the student's profile against the full catalogue.",
    width: 1440,
    height: 1153,
  },
];
---

<section class="border-b border-ink-200 bg-paper">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2 data-reveal class="text-[length:var(--text-h2)] font-semibold text-[color:var(--color-text)]">
      See it on your programme's catalogue
    </h2>
    <p class="mt-4 max-w-[var(--prose-max)] font-[family-name:var(--font-body)] text-[color:var(--color-text-muted)]">
      A walkthrough of the live TU Delft MSc Aerospace Engineering planner — the same
      experience your students would get once your programme's rules are encoded.
    </p>

    <div class="mt-12 flex flex-col gap-16">
      {screens.map((s) => (
        <figure class="grid gap-8 lg:grid-cols-[1fr_3fr] lg:items-start">
          <figcaption class="lg:pt-4">
            <h3 class="font-[family-name:var(--font-heading)] text-[length:var(--text-h3)] font-semibold text-[color:var(--color-text)]">
              {s.title}
            </h3>
            <p class="mt-2 text-sm font-[family-name:var(--font-body)] leading-relaxed text-[color:var(--color-text-muted)]">
              {s.caption}
            </p>
            <a
              href={PLANNER_URL}
              target="_blank"
              rel="noreferrer"
              data-track="cta-screenshots-planner"
              class="mt-4 inline-flex items-center text-sm font-semibold text-ink-700 underline underline-offset-2"
            >
              Try it in the live demo →
            </a>
          </figcaption>
          <BrowserFrame
            src={s.src}
            alt={s.alt}
            width={s.width}
            height={s.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
