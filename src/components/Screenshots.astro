---
import BrowserFrame from "./BrowserFrame.astro";
import { PLANNER_URL } from "../config/site";

const screens = [
  {
    src: "/screenshots/screenshot-tracks.png",
    url: "planner.studyplanner.eu/tracks",
    alt: "Track selection screen: choosing a specialisation, with mandatory courses pre-loaded",
    title: "Pick track and profile",
    caption:
      "Step 1: the student picks their specialisation. Mandatory courses pre-load instantly. The profile panel on the right shows sub-tracks to narrow elective recommendations.",
    width: 1903,
    height: 848,
  },
  {
    src: "/screenshots/screenshot-3.png",
    url: "planner.studyplanner.eu/plan/2025-2026",
    alt: "Full study plan grid with live validation and AI recommendations across four quarters",
    title: "Full plan: live validation + AI",
    caption:
      "The plan view: four quarters per year, real-time EC totals, prerequisite conflict flags, workload indicators, and an AI recommendation panel that analyses the student's profile against the full catalogue.",
    width: 1440,
    height: 1153,
  },
];
---

<section class="border-b border-line bg-paper text-ink">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2
      data-reveal
      class="max-w-[20ch] serif-heading text-[length:var(--text-h2)] text-ink"
    >
      See it on your programme's catalogue
    </h2>
    <p class="mt-4 max-w-[var(--prose-max)] text-[length:var(--text-lead)] leading-relaxed text-muted">
      A walkthrough of a live MSc Aerospace Engineering planner, the same experience
      your students would get once your programme's rules are encoded.
    </p>

    <div class="mt-14 flex flex-col gap-16 lg:gap-20">
      {screens.map((s, i) => {
        const flip = i % 2 === 1;
        // Last walkthrough goes full-width: the plan grid deserves the whole
        // container. (Trimmed to two entries 2026-08-16 to cut student-planner
        // page space in favour of the admin console sections.)
        const full = i === 1;
        return (
          <figure
            data-reveal
            class:list={[
              full
                ? "flex flex-col gap-8"
                : "grid items-center gap-8 lg:grid-cols-2 lg:gap-14",
            ]}
          >
            <figcaption class:list={["min-w-0", !full && flip && "lg:order-2", full && "max-w-xl"]}>
              <h3 class="flex items-center gap-2.5 text-[length:var(--text-h3)] font-semibold tracking-tight text-ink">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-[1px] bg-accent"></span>
                {s.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{s.caption}</p>
            </figcaption>
            <div class:list={["min-w-0", !full && flip && "lg:order-1"]}>
              <BrowserFrame
                src={s.src}
                alt={s.alt}
                url={s.url}
                live={true}
                tone="light"
                width={s.width}
                height={s.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
        );
      })}
    </div>
  </div>
</section>
