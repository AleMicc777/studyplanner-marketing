---
import { PLANNER_URL, bookDemoHref } from "../config/site";
const navLinks = [
  { href: "/#how-it-works", label: "How it works", external: false },
  { href: "/#universities", label: "For universities", external: false },
  { href: PLANNER_URL, label: "Demo", external: true },
  { href: "/contact", label: "Contact", external: false },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper">
  <!-- Pure-CSS mobile toggle: checkbox must be a sibling of everything it controls -->
  <input type="checkbox" id="nav-toggle" class="peer sr-only" />

  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <!-- Wordmark with amber square mark -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 text-[1.12rem] font-extrabold tracking-[-0.03em] text-ink"
    >
      <span class="brand-mark" aria-hidden="true"></span>
      StudyPlanner
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {navLinks.map((l) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noreferrer" : undefined}
          class="text-[0.96rem] font-medium text-muted transition-colors hover:text-ink"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA: amber primary -->
    <a
      href={bookDemoHref}
      data-track="cta-nav-book"
      class="hidden items-center justify-center rounded-md border border-amber bg-amber px-4 py-2 text-[0.92rem] font-semibold text-graphite transition-colors hover:border-amber-hover hover:bg-amber-hover md:inline-flex"
    >
      Book a 20-min demo
    </a>

    <!-- Mobile hamburger label -->
    <label
      for="nav-toggle"
      class="flex cursor-pointer items-center rounded-md border border-line p-2 text-ink hover:border-amber md:hidden"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <!-- Mobile menu -->
  <div class="hidden border-t border-line bg-paper px-4 pb-4 pt-2 peer-checked:block md:hidden">
    {navLinks.map((l) => (
      <a
        href={l.href}
        target={l.external ? "_blank" : undefined}
        rel={l.external ? "noreferrer" : undefined}
        class="block border-b border-line px-4 py-3 text-sm font-medium text-muted hover:text-ink"
      >
        {l.label}
      </a>
    ))}
    <a
      href={bookDemoHref}
      data-track="cta-nav-book"
      class="mt-4 block rounded-md border border-amber bg-amber px-4 py-3 text-center text-sm font-semibold text-graphite hover:border-amber-hover hover:bg-amber-hover"
    >
      Book a 20-min demo
    </a>
    <a
      href={PLANNER_URL}
      target="_blank"
      rel="noreferrer"
      class="mt-2 block rounded-md border border-line px-4 py-3 text-center text-sm font-medium text-muted hover:border-amber hover:text-amber-deep"
    >
      Open the StudyPlanner
    </a>
  </div>
</header>

<style>
  /* Amber square brand mark: notched by an inset graphite ring, ringed in amber. */
  .brand-mark {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: var(--color-amber);
    box-shadow:
      inset 0 0 0 3px var(--color-paper),
      0 0 0 1px var(--color-amber);
    flex: none;
  }
</style>
