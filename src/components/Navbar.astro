---
import { PLANNER_URL, bookDemoHref } from "../config/site";
const navLinks = [
  { href: "/#how-it-works", label: "How it works", external: false },
  { href: "/#universities", label: "For universities", external: false },
  { href: PLANNER_URL, label: "Demo", external: true },
  { href: "/contact", label: "Contact", external: false },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-ink-200)] bg-[var(--color-paper)]/95 backdrop-blur">
  <!-- Pure-CSS mobile toggle: checkbox must be sibling of everything it controls -->
  <input type="checkbox" id="nav-toggle" class="peer sr-only" />

  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 h-16">
    <!-- Wordmark -->
    <a href="/" class="flex items-center gap-2 font-heading text-lg font-semibold tracking-tight text-[var(--color-ink-950)] shrink-0">
      StudyPlanner
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map((l) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noreferrer" : undefined}
          class="rounded-md px-4 py-2 text-sm font-medium text-[var(--color-text-muted)] transition hover:text-[var(--color-ink-950)]"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <a
      href={bookDemoHref}
      data-track="cta-nav-book"
      class="hidden md:inline-flex items-center justify-center rounded-none border border-[var(--color-ink-950)] bg-[var(--color-ink-950)] px-4 py-2 text-sm font-semibold text-[var(--color-paper)] transition hover:bg-[var(--color-ink-700)]"
    >
      Book a demo
    </a>

    <!-- Mobile hamburger label -->
    <label
      for="nav-toggle"
      class="md:hidden flex cursor-pointer items-center rounded-md p-2 text-[var(--color-ink-950)] hover:bg-[var(--color-paper-shade)]"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <!-- Mobile menu -->
  <div class="hidden peer-checked:block md:hidden border-t border-[var(--color-ink-200)] bg-[var(--color-paper)] px-4 pb-4 pt-2">
    {navLinks.map((l) => (
      <a
        href={l.href}
        target={l.external ? "_blank" : undefined}
        rel={l.external ? "noreferrer" : undefined}
        class="block rounded-md px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-ink-950)]"
      >
        {l.label}
      </a>
    ))}
    <a
      href={bookDemoHref}
      data-track="cta-nav-book"
      class="mt-3 block rounded-none border border-[var(--color-ink-950)] bg-[var(--color-ink-950)] px-4 py-3 text-center text-sm font-semibold text-[var(--color-paper)] hover:bg-[var(--color-ink-700)]"
    >
      Book a demo
    </a>
    <a
      href={PLANNER_URL}
      target="_blank"
      rel="noreferrer"
      class="mt-2 block rounded-none border border-[var(--color-ink-200)] px-4 py-3 text-center text-sm font-medium text-[var(--color-text-muted)] hover:text-[var(--color-ink-950)]"
    >
      Open the StudyPlanner →
    </a>
  </div>
</header>
