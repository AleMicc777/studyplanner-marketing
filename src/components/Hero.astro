---
import { bookDemoHref } from "../config/site";
import BrowserFrame from "./BrowserFrame.astro";
import CTAButton from "./CTAButton.astro";
import RoleCursor from "./RoleCursor.astro";
import VerdictCard from "./VerdictCard.astro";
---

<section class="grid-bg bg-paper">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center px-6 pb-(--section-y) pt-[clamp(4.5rem,3.5rem+4vw,7rem)] text-center"
  >
    <h1 class="serif-display hero-stagger-1 text-[length:var(--text-display)] text-ink">
      Every study plan, <span class="text-accent-deep">valid on arrival</span>.
    </h1>

    <p
      class="hero-stagger-2 mt-6 max-w-[52ch] text-[length:var(--text-lead)] leading-[1.55] text-muted"
    >
      Encode your rules once; every student plan is checked live, and
      coordinators approve instead of debugging.
    </p>

    <div class="hero-stagger-3 mt-8">
      <CTAButton
        href={bookDemoHref}
        dataTrack="cta-hero-demo"
        class="md:px-8 md:py-4 md:text-base"
      >
        Book a 20-min demo
      </CTAButton>
    </div>

    <!-- Load stagger on this outer wrapper, data-reveal on the inner relative
         one: on a single element the stagger keyframe and the reveal transition
         both drive opacity and race each other. -->
    <div class="hero-stagger-4 mt-16 w-[min(1080px,92vw)]">
      <div class="relative" data-reveal>
        <BrowserFrame
          src="/screenshots/screenshot-3.png"
          alt="Full study plan grid with live validation across four quarters"
          url="planner.studyplanner.eu"
          tone="light"
          ticks
          live
          width={1440}
          height={1153}
          loading="eager"
          fetchpriority="high"
        />

        <!-- Positioning wrappers, not classes on RoleCursor itself: its reveal
             sets transform on the root, which would erase a Tailwind scale.
             Below lg the cursors stay pinned, scaled down slightly. -->
        <div class="absolute left-[18%] top-[35%] z-10 origin-top-left scale-90 lg:scale-100">
          <RoleCursor role="student" rotate={-10} />
        </div>
        <!-- Right-edge pin below lg so pill + disc never clip the 390 viewport;
             percentage pin only from lg up. -->
        <div class="absolute right-[3%] top-[15%] z-10 origin-top-right scale-90 lg:left-[78%] lg:right-auto lg:origin-top-left lg:scale-100">
          <RoleCursor role="coordinator" rotate={14} />
        </div>

        <!-- lg: -24px overhang past the frame's bottom-right corner. Below lg
             it docks under the frame (old hero chip pattern) so the product
             screenshot stays fully visible. -->
        <VerdictCard
          class="relative z-10 mx-auto mt-4 lg:absolute lg:-bottom-6 lg:-right-6 lg:mx-0 lg:mt-0"
        />
      </div>
    </div>
  </div>
</section>
