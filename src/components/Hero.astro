---
import { PLANNER_URL, bookDemoHref } from "../config/site";
import BrowserFrame from "./BrowserFrame.astro";
import CTAButton from "./CTAButton.astro";
---

<section class="relative overflow-hidden bg-ink-900">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.06]"
    style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:40px 40px;"
  ></div>
  <div class="relative mx-auto max-w-6xl px-6 pt-24 pb-0 sm:pt-32">
    <h1
      class="hero-stagger-1 max-w-3xl font-heading text-[length:var(--text-display)] font-semibold text-paper"
    >
      Every study plan checked against your rules — before it reaches your inbox.
    </h1>
    <p
      class="hero-stagger-2 mt-6 max-w-2xl text-[length:var(--text-lead)] text-ink-200"
    >
      StudyPlanner encodes your MSc programme's requirements — prerequisites, EC totals, track rules — and validates each student's plan in real time. Coordinators approve; they no longer debug.
    </p>
    <div class="hero-stagger-3 mt-10 flex flex-wrap items-center gap-4">
      <CTAButton href={bookDemoHref} dataTrack="cta-hero-demo">
        Book a 20-minute demo
      </CTAButton>
      <CTAButton
        href={PLANNER_URL}
        variant="outline"
        target="_blank"
        rel="noreferrer"
        dataTrack="open-planner"
      >
        Try the live planner →
      </CTAButton>
    </div>

    <!-- Product screenshot in a simple browser frame, bleeding into the section below -->
    <div class="hero-stagger-4 mt-16 -mb-24 sm:-mb-32">
      <div class="mx-auto max-w-4xl">
        <BrowserFrame
          src="/screenshots/screenshot-1.png"
          alt="StudyPlanner interface showing a validated MSc study plan"
          width={1600}
          height={1000}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
