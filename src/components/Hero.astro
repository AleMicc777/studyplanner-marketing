---
/*
 * Two-column hero (Civic Cobalt). Text left, product frame right, verdict card
 * overhanging its bottom-right corner. The h1 drops off --text-display to a
 * narrower clamp because it no longer spans the full container.
 *
 * The 2x2 mono credential grid at the bottom of the left column is the former
 * TrustBar section, folded above the fold where it actually earns its space.
 */
import { PLANNER_URL, bookDemoHref } from "../config/site";
import BrowserFrame from "./BrowserFrame.astro";
import CTAButton from "./CTAButton.astro";
import RoleCursor from "./RoleCursor.astro";
import VerdictCard from "./VerdictCard.astro";

const credentials = [
  { lead: "Live MSc planner", rest: " you can open now" },
  { lead: "500+", rest: " courses encoded" },
  { lead: "EU-hosted", rest: ", GDPR-ready" },
  { lead: "No student data", rest: " to evaluate" },
];
---

<section class="grid-bg border-b border-line bg-paper">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-[clamp(2.5rem,1rem+4vw,4.5rem)] px-6 pb-[clamp(4rem,3rem+4vw,6rem)] pt-[clamp(3.5rem,2.5rem+3vw,5.5rem)] lg:grid-cols-[minmax(0,1.02fr)_minmax(0,1fr)]"
  >
    <div class="min-w-0">
      <p
        class="hero-stagger-1 inline-flex items-center gap-2 font-mono text-[0.78rem] tracking-[0.02em] text-cobalt-ink"
      >
        <span aria-hidden="true" class="h-1.5 w-1.5 flex-none rounded-[1px] bg-cobalt-ink"></span>
        MSc programme rule engine
      </p>

      <h1
        class="serif-display hero-stagger-1 mt-5 text-[length:clamp(2.75rem,1.6rem+3.6vw,5rem)] text-ink"
      >
        Every study plan, <span class="text-cobalt-ink">valid on arrival</span>.
      </h1>

      <p
        class="hero-stagger-2 mt-6 max-w-[48ch] text-[length:var(--text-lead)] leading-[1.55] text-muted"
      >
        Encode your programme's rules once. Every student plan is checked
        against them live, so coordinators approve instead of debugging.
      </p>

      <div class="hero-stagger-3 mt-8 flex flex-wrap items-center gap-5">
        <CTAButton href={bookDemoHref} dataTrack="cta-hero-demo">
          Book a 20-min demo
        </CTAButton>
        <a
          href={PLANNER_URL}
          target="_blank"
          rel="noreferrer"
          data-track="cta-hero-planner"
          class="group inline-flex min-h-11 items-center gap-2 text-[0.95rem] font-semibold text-cobalt-ink underline decoration-cobalt-ink/35 underline-offset-[5px] transition-colors hover:text-cobalt-bright"
        >
          Open the live planner
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>

      <ul
        class="hero-stagger-4 mt-10 grid grid-cols-1 gap-x-6 gap-y-3 border-t border-line pt-5 sm:grid-cols-2"
      >
        {
          credentials.map((c) => (
            <li class="flex items-baseline gap-2 font-mono text-[0.8rem] tracking-[-0.01em] text-muted">
              <span aria-hidden="true" class="flex-none text-cobalt-ink">&#10003;</span>
              <span>
                <b class="font-medium text-ink">{c.lead}</b>
                {c.rest}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-stagger-4 min-w-0">
      <!-- data-reveal on the inner wrapper, stagger on the outer: on a single
           element the keyframe and the reveal transition both drive opacity. -->
      <div class="relative" data-reveal>
        <BrowserFrame
          src="/screenshots/screenshot-3.png"
          alt="Study plan grid with live rule validation across four quarters"
          url="planner.studyplanner.eu"
          tone="light"
          ticks
          live
          width={1440}
          height={1153}
          loading="eager"
          fetchpriority="high"
        />

        <!-- Positioning wrappers, not classes on RoleCursor itself: its reveal
             sets transform on the root, which would erase a Tailwind scale. -->
        <div class="absolute left-[14%] top-[34%] z-10 origin-top-left scale-90 lg:scale-100">
          <RoleCursor role="student" rotate={-10} />
        </div>
        <div
          class="absolute right-[3%] top-[12%] z-10 origin-top-right scale-90 lg:scale-100"
        >
          <RoleCursor role="coordinator" rotate={14} />
        </div>

        <!-- lg: overhangs the frame's bottom-right corner. Below lg it docks
             under the frame so the screenshot stays fully visible. -->
        <VerdictCard
          class="relative z-10 mx-auto mt-4 lg:absolute lg:-bottom-[22px] lg:-right-[10px] lg:mx-0 lg:mt-0"
        />
      </div>

      <!-- Remove this caption once real own-branded captures land. -->
      <p class="mt-[42px] font-mono text-[0.74rem] tracking-[0.01em] text-muted">
        placeholder capture — replace with an own-branded planner shot
      </p>
    </div>
  </div>
</section>
