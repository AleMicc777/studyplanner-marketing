---
/*
 * Founder note + founding-pilot ask, one centred column. The quote is
 * attributed to the founder, never dressed up as a customer testimonial —
 * there is no reference customer yet and inventing one is the failure mode
 * this section exists to avoid.
 */
import { bookDemoHref } from "../config/site";
import CTAButton from "./CTAButton.astro";
---

<section class="border-b border-line bg-paper text-ink">
  <div class="mx-auto max-w-3xl px-6 py-[var(--section-y)]">
    <div class="text-center">
      <p class="font-mono text-xs tracking-[0.02em] text-cobalt-ink">// founder note</p>
      <blockquote
        data-reveal
        class="mt-[18px] font-[family-name:var(--font-serif)] text-[length:clamp(1.2rem,1.05rem+0.7vw,1.65rem)] font-medium leading-[1.4] tracking-[-0.01em] text-ink [font-optical-sizing:auto]"
      >
        "Coordinators didn't need another dashboard. They needed the plan to be
        right before it landed in their inbox. So we moved the check to the
        moment a student builds the plan, and encoded the programme guide they
        already hand out."
      </blockquote>
      <p class="mt-6 font-mono text-sm text-muted">
        <span class="font-medium text-ink">Alessandro Miccolo</span> / Founder, StudyPlanner
      </p>
    </div>

    <div
      class="mt-[clamp(2.5rem,2rem+1.5vw,3.5rem)] border-t border-line pt-[clamp(2rem,1.5rem+1.5vw,3rem)]"
    >
      <h2
        data-reveal
        class="serif-heading max-w-[24ch] text-[length:clamp(1.75rem,1.3rem+1.8vw,2.5rem)] text-ink"
      >
        Become the founding pilot in your country
      </h2>
      <p class="mt-4 max-w-[56ch] leading-relaxed text-muted">
        We're taking on a small number of founding-partner programmes at pilot
        pricing, one per country, while the catalogue library grows. You see your
        own programme's rules running before any commitment.
      </p>
      <div class="mt-7">
        <CTAButton href={bookDemoHref} dataTrack="cta-founding-pilot">
          Book a 20-min demo
        </CTAButton>
      </div>
    </div>
  </div>
</section>
