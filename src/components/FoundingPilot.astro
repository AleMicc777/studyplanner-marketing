---
import { bookDemoHref } from "../config/site";
import CTAButton from "./CTAButton.astro";
/*
 * Honest first-party statement in place of a customer testimonial (there are no
 * real third-party quotes to show yet). A founder POV is truthful, humanising,
 * and reads well for an early-stage B2B pilot. Attributed to the founder, not
 * dressed up as a customer quote. The "// founder note" label makes the source
 * explicit so this never reads as a fabricated testimonial.
 */
---

<section class="border-b border-line bg-paper-shade text-ink">
  <div class="mx-auto max-w-3xl px-6 py-[var(--section-y)] text-center">
    <p class="font-mono text-xs tracking-[0.02em] text-amber-deep">// founder note</p>
    <blockquote
      data-reveal
      class="mt-4 text-[length:var(--text-h3)] leading-relaxed tracking-[-0.01em] text-ink"
    >
      "Coordinators didn't need another dashboard. They needed the plan to be
      right before it landed in their inbox. So we moved the check to the moment
      a student builds the plan, and encoded the programme guide they already
      hand out."
    </blockquote>
    <figcaption class="mt-6 font-mono text-sm text-muted">
      <span class="font-semibold text-ink">Alessandro Miccolo</span>
      · Founder, StudyPlanner
    </figcaption>

    <div class="mx-auto mt-12 max-w-xl border-t border-line pt-10">
      <h2 class="text-[length:var(--text-h3)] font-semibold tracking-[-0.02em] text-ink">
        Become the founding pilot in your country
      </h2>
      <p class="mt-3 text-muted">
        We're taking on a small number of founding-partner programmes at pilot
        pricing, one per country, while the catalogue library grows. You see your
        own programme's rules running before any commitment.
      </p>
      <p class="mt-4 font-mono text-sm text-muted">
        Built for large MSc programmes like TUM's.
      </p>
      <div class="mt-8 flex justify-center">
        <CTAButton href={bookDemoHref} variant="solid-dark" dataTrack="cta-founding-book">
          Book a 20-min demo
        </CTAButton>
      </div>
    </div>
  </div>
</section>
