---
import { bookDemoHref } from "../config/site";
import CTAButton from "./CTAButton.astro";
import ReviewInboxCard from "./ReviewInboxCard.astro";
import RoleCursor from "./RoleCursor.astro";
const points = [
  {
    title: "Multi-tenant from day one",
    body: "Each university gets its own catalogue, rules, branding, and subdomain. No shared state with any other institution.",
  },
  {
    title: "Zero onboarding cost for the pilot",
    body: "The founding pilot gets a free encoded prototype of your catalogue before any commitment. Custom pricing per institution applies after that.",
  },
  {
    title: "Programme analytics for coordinators",
    body: "Aggregate elective demand, common invalid configurations, and where students get stuck. Anonymised and opt-in.",
  },
  {
    title: "We handle the rules encoding",
    body: "Send us your programme guide and we encode the validation logic, then keep it up to date each academic year.",
  },
];
---

<section class="border-b border-line bg-paper-shade text-ink">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.55fr] lg:gap-16">
      <div>
        <h2 data-reveal class="serif-heading text-[length:var(--text-h2)] text-ink">
          For universities
        </h2>
        <p class="mt-5 text-muted">
          StudyPlanner is built to be deployed across programmes and institutions, not just
          one, and to scale to large MSc programmes like TU Munich's. If you coordinate an
          MSc and want fewer plan-validation emails next term, let's talk.
        </p>
        <p class="mt-4 text-muted">
          Priced per institution, per programme. Pilot programmes start with a free encoded
          prototype of your own catalogue. You see your rules running before any commitment.
        </p>
        <CTAButton
          href={bookDemoHref}
          variant="outline-invert"
          dataTrack="cta-universities-book"
          class="mt-8"
        >
          Book a 20-min demo
        </CTAButton>

        <!-- Product-echo card with the one Coordinator chip outside the hero;
             the chip pins to the card corner only, never to whitespace. -->
        <div data-reveal class="relative mt-12 w-[280px] max-w-full">
          <ReviewInboxCard />
          <RoleCursor
            role="coordinator"
            rotate={12}
            class="absolute -top-4 -right-4 sm:-top-5 sm:-right-6"
          />
        </div>
      </div>
      <dl data-reveal class="divide-y divide-line border-t border-line">
        {points.map((p, i) => (
          <div class="py-6 first:pt-0">
            <dt class="flex items-start gap-3 text-base font-semibold text-ink">
              <span class="mt-1 shrink-0 font-mono text-xs tabular-nums text-accent-deep" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              {p.title}
            </dt>
            <dd class="mt-2 pl-7 text-sm leading-relaxed text-muted">{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
