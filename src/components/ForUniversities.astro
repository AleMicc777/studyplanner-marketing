---
/*
 * Homepage teaser only. The full institutional case — admin dashboard, catalogue
 * control, cohort analytics — lives on /for-universities; this is the four-point
 * summary that sends buyer-intent traffic there.
 */
const points = [
  {
    title: "We handle the rules encoding",
    body: "Kept current each academic year. No IT project on your side.",
  },
  {
    title: "Module demand forecast",
    body: "Seats demanded per module and per term, before registration opens.",
  },
  {
    title: "Advising load, counted",
    body: "Rule checks run, staff hours saved, plans exported for advising sessions.",
  },
  {
    title: "Your own tenant",
    body: "Own catalogue, rules, branding and subdomain. No shared state.",
  },
];
---

<section class="border-b border-line bg-paper-shade text-ink">
  <div
    class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-[clamp(2.5rem,1.5rem+3vw,5rem)] px-6 py-[var(--section-y)] lg:grid-cols-2"
  >
    <div>
      <p class="font-mono text-xs tracking-[0.02em] text-cobalt-ink">// for universities</p>
      <h2
        data-reveal
        class="serif-heading mt-5 max-w-[20ch] text-[length:var(--text-h2)] text-ink"
      >
        Students get a planner. Your office gets the product.
      </h2>
      <p class="mt-5 max-w-[48ch] text-[length:var(--text-lead)] leading-relaxed text-muted">
        A review queue of pre-checked plans, and a curriculum dashboard that
        turns what students actually choose into curriculum decisions.
      </p>
      <a
        href="/for-universities"
        data-track="link-for-universities"
        class="group mt-7 inline-flex min-h-11 items-center gap-2 text-[0.95rem] font-semibold text-cobalt-ink underline decoration-cobalt-ink/35 underline-offset-[5px] transition-colors hover:text-cobalt-bright"
      >
        Read the full case for universities
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </a>
    </div>

    <dl data-reveal class="border-t border-line">
      {
        points.map((p, i) => (
          <div
            class:list={[
              "flex items-start gap-3 py-[18px]",
              i !== points.length - 1 && "border-b border-line",
            ]}
          >
            <span
              aria-hidden="true"
              class="mt-[9px] h-1.5 w-1.5 flex-none rounded-[1px] bg-cobalt-ink"
            />
            <div>
              <dt class="font-semibold text-ink">{p.title}</dt>
              <dd class="mt-1 text-[0.94rem] leading-relaxed text-muted">{p.body}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
