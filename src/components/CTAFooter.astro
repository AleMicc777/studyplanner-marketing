---
import { PLANNER_URL, bookDemoHref, CONTACT_EMAIL } from "../config/site";
import CTAButton from "./CTAButton.astro";
---

<section class="bg-ink-950">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)] text-center">
    <h2 data-reveal class="text-[length:var(--text-h2)] font-semibold text-white">
      Book a 20-minute demo — bring your programme guide.
    </h2>
    <p class="mx-auto mt-4 max-w-xl font-[family-name:var(--font-body)] text-ink-200">
      We'll walk through the demo, show how the multi-tenant setup works, and scope what it
      would take for your programme.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <CTAButton href={bookDemoHref} dataTrack="cta-footer-book">
        Book a 20-min demo
      </CTAButton>
      <CTAButton
        href={PLANNER_URL}
        variant="outline-invert"
        target="_blank"
        rel="noreferrer"
        dataTrack="cta-footer-planner"
      >
        Try the planner first →
      </CTAButton>
    </div>

    <div class="mx-auto mt-16 max-w-6xl border-t border-ink-700 pt-6 text-left">
      <p class="text-xs font-[family-name:var(--font-body)] text-ink-200">
        StudyPlanner — Alessandro Miccolo ·
        {" "}
        <a href={`mailto:${CONTACT_EMAIL}`} class="underline underline-offset-2">{CONTACT_EMAIL}</a>
      </p>
    </div>
  </div>
</section>
