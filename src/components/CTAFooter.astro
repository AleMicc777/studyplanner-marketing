---
import { PLANNER_URL, bookDemoHref, CONTACT_EMAIL } from "../config/site";
import CTAButton from "./CTAButton.astro";
---

<!-- pb-24 at mobile keeps the sticky CTA bar from covering the copyright line. -->
<footer class="bg-cobalt-2 pb-24 text-on-dark md:pb-0">
  <div class="grid-bg-dark border-b border-cobalt-line">
    <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)] text-center">
      <h2 data-reveal class="mx-auto max-w-[24ch] serif-heading text-[length:var(--text-h2)] text-on-dark">
        Book a 20-minute demo. Bring your programme guide.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[length:var(--text-lead)] leading-relaxed text-on-dark-2">
        We'll walk through the demo, show how the multi-tenant setup works, and scope what it
        would take for your programme.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <CTAButton href={bookDemoHref} dataTrack="cta-footer-book">
          Book a 20-min demo
        </CTAButton>
        <CTAButton
          href={PLANNER_URL}
          variant="outline"
          target="_blank"
          rel="noreferrer"
          dataTrack="cta-footer-planner"
        >
          Try the live planner →
        </CTAButton>
      </div>
      <p class="mt-7 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 font-mono text-xs text-steel">
        <span class="text-valid" aria-hidden="true">✓</span>
        <span>EU-hosted</span>
        <span aria-hidden="true">/</span>
        <span>GDPR-ready</span>
        <span aria-hidden="true">/</span>
        <span>no student data required to evaluate</span>
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 text-left sm:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="flex items-center gap-2.5 text-lg font-semibold tracking-tight text-on-dark">
          <span aria-hidden="true" class="inline-block h-4 w-4 rounded-[4px] bg-accent ring-1 ring-accent"></span>
          StudyPlanner
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-on-dark-2">
          Study plans validated against your programme's rules, before they reach
          your inbox. Built for MSc coordinators.
        </p>
      </div>

      <nav aria-label="Footer" class="text-sm">
        <p class="font-semibold text-on-dark">Product</p>
        <ul class="mt-3 space-y-2 text-on-dark-2">
          <li><a href="/#how-it-works" class="transition-colors hover:text-accent">How it works</a></li>
          <li><a href="/for-universities" class="transition-colors hover:text-accent">For universities</a></li>
          <li><a href="/security" class="transition-colors hover:text-accent">Security</a></li>
          <li><a href="/#try" class="transition-colors hover:text-accent">Try the rule engine</a></li>
          <li><a href={PLANNER_URL} target="_blank" rel="noreferrer" class="transition-colors hover:text-accent">Live demo</a></li>
        </ul>
      </nav>

      <div class="text-sm">
        <p class="font-semibold text-on-dark">Company</p>
        <ul class="mt-3 space-y-2 text-on-dark-2">
          <li><a href="/guides/evaluating-degree-planning-software" class="transition-colors hover:text-accent">Buyer's guide</a></li>
          <li><a href="/#faq" class="transition-colors hover:text-accent">FAQ</a></li>
          <li><a href="/contact" class="transition-colors hover:text-accent">Contact us</a></li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`} class="underline decoration-cobalt-line underline-offset-4 transition-colors hover:text-accent">
              {CONTACT_EMAIL}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-10 border-t border-cobalt-line pt-6 font-mono text-xs text-steel">
      © 2026 StudyPlanner / Alessandro Miccolo / EU-hosted, GDPR-ready
    </p>
  </div>
</footer>
