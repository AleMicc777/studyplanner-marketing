---
import { PLANNER_URL, bookDemoHref } from "../config/site";
import BrowserFrame from "./BrowserFrame.astro";
import CTAButton from "./CTAButton.astro";

const blocks = [
  {
    label: "Challenge",
    body: "Advisors were fielding the same plan-validation emails every term. Students were unsure which electives satisfied prerequisite chains, EC totals, and track requirements across five specialisations.",
  },
  {
    label: "What was encoded",
    body: "Prerequisite chains, EC requirements, and PPD credits across every specialisation track, built directly from the programme guide.",
  },
];
---

<section class="border-b border-line bg-paper text-ink" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <p class="font-mono text-sm text-muted">
      <span class="text-amber-deep">//</span> Case study: a live MSc Aerospace Engineering programme
    </p>
    <p class="mt-2 font-mono text-sm text-muted">
      180+ courses encoded · 5 specialisation tracks · under 2 weeks to live.
    </p>

    <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
      <div class="min-w-0">
        <h2 class="text-[length:var(--text-h2)] font-extrabold tracking-[-0.04em] text-ink">
          From email chaos to self-service validation
        </h2>

        <div class="mt-8 divide-y divide-line">
          {blocks.map((b) => (
            <div class="py-5 first:pt-0">
              <h3 class="font-mono text-xs font-medium uppercase tracking-[0.08em] text-muted">
                {b.label}
              </h3>
              <p class="mt-2 text-muted">{b.body}</p>
            </div>
          ))}
          <div class="py-5">
            <h3 class="font-mono text-xs font-medium uppercase tracking-[0.08em] text-muted">
              Outcome
            </h3>
            <p class="mt-2 text-muted">
              Students now validate their own plans before an advising appointment, catching
              invalid configurations themselves. Early estimate:
              {" "}
              <span class="font-semibold text-amber-deep">~2 hours saved per student per year</span>
              {" "}
              on back-and-forth email. Estimates vary with programme complexity.
            </p>
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <CTAButton href={bookDemoHref} variant="solid" dataTrack="cta-casestudy-book">
            Book a 20-min demo
          </CTAButton>
          <CTAButton
            href={PLANNER_URL}
            target="_blank"
            rel="noreferrer"
            variant="outline-invert"
            dataTrack="cta-casestudy-planner"
          >
            Explore the live planner <span aria-hidden="true">&rarr;</span>
          </CTAButton>
        </div>
      </div>

      <BrowserFrame
        src="/screenshots/screenshot-3.png"
        alt="Full study plan grid with live EC validation and AI recommendations, a live MSc Aerospace Engineering programme"
        caption="The plan view students use before every advising appointment: four quarters per year, real-time EC totals, prerequisite conflict flags."
        url="planner.studyplanner.eu/plan/2025-2026"
        live={true}
        ticks={true}
        tone="light"
        width={1440}
        height={1153}
      />
    </div>
  </div>
</section>
