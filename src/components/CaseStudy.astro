---
import { PLANNER_URL, bookDemoHref } from "../config/site";
import BrowserFrame from "./BrowserFrame.astro";
import CTAButton from "./CTAButton.astro";
---

<section class="border-b border-ink-200 bg-ink-950" data-reveal>
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <p class="font-[family-name:var(--font-heading)] text-sm font-semibold text-ink-200">
      Case study — TU Delft, MSc Aerospace Engineering
    </p>
    <p class="mt-1 text-sm text-ink-200">
      180+ courses encoded · 5 specialisation tracks · under 2 weeks to live.
    </p>

    <div class="mt-8 grid gap-12 lg:grid-cols-2 lg:items-start">
      <div>
        <h2 class="text-[length:var(--text-h2)] font-semibold text-white">
          From email chaos to self-service validation
        </h2>

        <div class="mt-8 space-y-6 font-[family-name:var(--font-body)] text-ink-200">
          <div>
            <h3 class="font-[family-name:var(--font-heading)] text-sm font-semibold uppercase tracking-normal text-white">
              Challenge
            </h3>
            <p class="mt-1">
              Advisors were fielding the same plan-validation emails every term — students unsure
              which electives satisfied prerequisite chains, EC totals, and track requirements
              across five specialisations.
            </p>
          </div>
          <div>
            <h3 class="font-[family-name:var(--font-heading)] text-sm font-semibold uppercase tracking-normal text-white">
              What was encoded
            </h3>
            <p class="mt-1">
              Prerequisite chains, EC requirements, and PPD credits across every specialisation
              track — built directly from the programme guide.
            </p>
          </div>
          <div>
            <h3 class="font-[family-name:var(--font-heading)] text-sm font-semibold uppercase tracking-normal text-white">
              Outcome
            </h3>
            <p class="mt-1">
              Students now validate their own plans before an advising appointment, catching
              invalid configurations themselves. Early estimate:
              {" "}
              <span class="font-semibold text-valid-600">~2 hours saved per student per year</span>
              {" "}
              on back-and-forth email — estimates subject to programme complexity.
            </p>
          </div>
        </div>

        <div class="mt-10 border border-ink-700 bg-ink-900 p-6">
          <p class="font-[family-name:var(--font-heading)] font-semibold text-white">
            Become the pilot programme in your country
          </p>
          <p class="mt-2 text-sm font-[family-name:var(--font-body)] text-ink-200">
            We're taking on a small number of founding-partner programmes at pilot pricing,
            one per country, while the catalogue library grows. If that's you, let's talk.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-4">
          <CTAButton
            href={PLANNER_URL}
            target="_blank"
            rel="noreferrer"
            dataTrack="cta-casestudy-planner"
          >
            See the live plan →
          </CTAButton>
          <CTAButton href={bookDemoHref} variant="outline-invert" dataTrack="cta-casestudy-book">
            Book a demo for your programme
          </CTAButton>
        </div>
      </div>

      <BrowserFrame
        src="/screenshots/screenshot-3.png"
        alt="Full study plan grid with live EC validation and AI recommendations, TU Delft MSc Aerospace Engineering"
        caption="The plan view students use before every advising appointment: four quarters per year, real-time EC totals, prerequisite conflict flags."
        width={1440}
        height={1153}
      />
    </div>
  </div>
</section>
