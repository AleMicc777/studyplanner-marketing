---
/*
 * Sits directly under the Hero: splits the two staff roles who land here
 * (the site is aimed at university workers — administrators and advisors —
 * not students). Asymmetric on purpose: the programme director/administrator
 * is the buyer, so that lane runs wider and first; the advisor lane links to
 * the live planner so they can see the tool their students would use. One
 * hairline divides them (vertical on desktop, horizontal once they stack on
 * mobile), matching the Stats/TrustBar divider technique.
 */
import { PLANNER_URL, bookDemoHref } from "../config/site";
import CTAButton from "./CTAButton.astro";
---

<section class="border-b border-line bg-paper-shade text-ink">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <p data-reveal class="font-mono text-xs tracking-[0.02em] text-cobalt-ink">
      // choose where you start
    </p>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-[1.35fr_1fr]">
      <!-- Lane A: programme director — primary, wider, first -->
      <div data-reveal class="lg:pr-12">
        <h3 class="flex items-center gap-2 text-[length:var(--text-h3)] font-semibold tracking-tight text-ink">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-[1px] bg-accent"></span>
          I run a programme
        </h3>
        <p class="mt-3 max-w-[var(--prose-max)] text-muted">
          We encode your programme's rules once, from the programme guide you already publish; every student plan is then checked against them automatically.
        </p>
        <CTAButton href={bookDemoHref} dataTrack="cta-router-demo" class="mt-6">
          Book a 20-min demo
        </CTAButton>
      </div>

      <!-- Lane B: advisor/coordinator — quieter, stacks below on mobile with a horizontal hairline -->
      <div
        data-reveal
        class="mt-8 border-t border-line pt-8 lg:mt-0 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0"
      >
        <h3 class="flex items-center gap-2 text-[length:var(--text-h3)] font-semibold tracking-tight text-ink">
          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-[1px] bg-accent"></span>
          I advise students
        </h3>
        <p class="mt-3 max-w-[38ch] text-muted">
          See the planner your students would use, and the validated plans that would land in your inbox instead of half-built PDFs.
        </p>
        <a
          href={PLANNER_URL}
          target="_blank"
          rel="noreferrer"
          data-track="cta-router-planner"
          class="group mt-6 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-cobalt-ink underline decoration-cobalt-ink/40 underline-offset-4 transition-colors hover:text-cobalt-bright"
        >
          Open the live planner
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
