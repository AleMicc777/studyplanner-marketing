---
const flow = [
  {
    title: "Programme guide (PDF)",
    body: "You send the current programme guide — the same document you already hand students.",
  },
  {
    title: "Encoded rules",
    body: "We turn it into a rule set: mandatory courses, prerequisites, EC totals, track requirements. No IT department needed.",
  },
  {
    title: "Validated plan",
    body: "Students build plans against those rules. Every change is checked live, before it reaches you.",
  },
];
---

<section id="how-it-works" class="border-b border-[var(--color-ink-200)] bg-[var(--color-paper)]">
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2 data-reveal class="font-heading text-[length:var(--text-h2)] font-semibold text-ink-950">How it works</h2>
    <p class="mt-4 max-w-xl text-[var(--color-text-muted)]">
      You send the programme guide; we encode it — no IT department needed.
    </p>

    <div class="mt-14 flex flex-col items-stretch gap-0 sm:flex-row sm:items-start">
      {flow.map((step, i) => (
        <>
          <div class="flex-1 border border-[var(--color-ink-200)] bg-[var(--color-paper-shade)] p-6">
            <h3 class="font-heading font-semibold text-[var(--color-ink-950)]">{step.title}</h3>
            <p class="mt-2 text-sm text-[var(--color-text-muted)]">{step.body}</p>
          </div>
          {i < flow.length - 1 && (
            <div class="flex items-center justify-center px-2 py-4 sm:py-0" aria-hidden="true">
              <span class="text-2xl text-[var(--color-ink-500)] rotate-90 sm:rotate-0">→</span>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
