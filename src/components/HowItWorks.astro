---
const flow = [
  {
    title: "Programme guide (PDF)",
    body: "You send the current programme guide, the same document you already hand students.",
  },
  {
    title: "Encoded rules",
    body: "We turn it into a rule set: mandatory courses, prerequisites, EC totals, track requirements. No IT department needed.",
  },
  {
    title: "Validated plan",
    body: "Students build plans against those rules. Every change is checked live, before it reaches you.",
  },
];
---

<section
  id="how-it-works"
  class="border-t border-line border-b bg-paper text-ink"
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2
      data-reveal
      class="text-[length:var(--text-h2)] font-extrabold tracking-[-0.04em] text-ink"
    >
      How it works
    </h2>
    <p class="mt-4 max-w-xl text-[length:var(--text-lead)] text-muted">
      You send the programme guide; we encode it. No IT department needed.
    </p>

    <ol class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-3">
      {
        flow.map((step, i) => (
          <li data-reveal class="border-t border-line pt-5">
            <span class="font-mono text-sm font-medium tracking-[0.06em] text-amber-deep tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 text-[length:var(--text-h3)] font-semibold text-ink">
              {step.title}
            </h3>
            <p class="mt-2 text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
