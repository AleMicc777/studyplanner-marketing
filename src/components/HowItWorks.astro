---
import InkRuleStamp from "./ink/InkRuleStamp.astro";
import ECCounterCard from "./ECCounterCard.astro";
import RoleCursor from "./RoleCursor.astro";
---

<section
  id="how-it-works"
  class="border-t border-line border-b bg-paper text-ink"
>
  <div class="mx-auto max-w-6xl px-6 py-[var(--section-y)]">
    <h2
      data-reveal
      class="serif-heading text-[length:var(--text-h2)] text-ink"
    >
      How it works
    </h2>
    <p class="mt-4 max-w-xl text-[length:var(--text-lead)] text-muted">
      You send the programme guide; we encode it. No IT department needed.
    </p>

    <ol class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-3">
      <li data-reveal class="border-t border-line pt-5">
        <span class="font-mono text-sm font-medium tracking-[0.06em] text-accent-deep tabular-nums">
          01
        </span>
        <h3 class="mt-3 text-[length:var(--text-h3)] font-semibold text-ink">
          Programme guide (PDF)
        </h3>
        <p class="mt-2 text-muted">
          You send the current programme guide, the same document you already hand students.
        </p>
      </li>

      <li data-reveal class="border-t border-line pt-5">
        <span class="font-mono text-sm font-medium tracking-[0.06em] text-accent-deep tabular-nums">
          02
        </span>
        <div class="mt-3 flex flex-wrap items-center gap-4">
          <div
            aria-hidden="true"
            class="aspect-square w-[132px] shrink-0 md:w-[200px]"
          >
            <InkRuleStamp class="h-full w-full" />
          </div>
          <h3 class="text-[length:var(--text-h3)] font-semibold text-ink">
            Encoded rules
          </h3>
        </div>
        <p class="mt-2 text-muted">
          We turn it into a rule set: mandatory courses, prerequisites, EC totals, track
          requirements. No IT department needed.
        </p>
      </li>

      <li data-reveal class="border-t border-line pt-5">
        <span class="font-mono text-sm font-medium tracking-[0.06em] text-accent-deep tabular-nums">
          03
        </span>
        <h3 class="mt-3 text-[length:var(--text-h3)] font-semibold text-ink">
          Validated plan
        </h3>
        <p class="mt-2 text-muted">
          Students build plans against those rules. Every change is checked live, before it
          reaches you.
        </p>
        <div class="relative mt-6 w-full max-w-[300px]">
          <ECCounterCard />
          <RoleCursor role="student" rotate={-8} class="absolute -top-3 right-4" />
        </div>
      </li>
    </ol>
  </div>
</section>
