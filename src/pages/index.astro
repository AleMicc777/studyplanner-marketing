---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import Problem from "../components/Problem.astro";
import Stats from "../components/Stats.astro";
import HowItWorks from "../components/HowItWorks.astro";
import RuleCheck from "../components/RuleCheck.astro";
import FoundingPilot from "../components/FoundingPilot.astro";
import ForUniversities from "../components/ForUniversities.astro";
import SecurityTeaser from "../components/SecurityTeaser.astro";
import FAQ from "../components/FAQ.astro";
import CTAFooter from "../components/CTAFooter.astro";
import { PLANNER_URL, CONTACT_EMAIL } from "../config/site";
import { generalFaqs } from "../data/faqs";

const SITE = "https://studyplanner-marketing-steel.vercel.app";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "StudyPlanner",
    url: SITE,
    logo: `${SITE}/favicon.svg`,
    contactPoint: {
      "@type": "ContactPoint",
      email: CONTACT_EMAIL,
      contactType: "sales",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "StudyPlanner",
    applicationCategory: "EducationalApplication",
    operatingSystem: "Web",
    url: PLANNER_URL,
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      description: "Custom pricing per institution. Contact for a quote.",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    // Security questions are excluded here: their FAQPage markup ships on
    // /security instead, so no question is marked up on two indexable URLs.
    mainEntity: generalFaqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  },
];
---

<Base jsonLd={jsonLd}>
  <Navbar />
  <main class="flex-1">
    <!-- Order per the "Page Order" design: proof of the problem, then the
         mechanism, then the numbers, then the two buyer lanes as teasers that
         send traffic to /for-universities and /security. The admin console and
         the full security detail now live on those pages, not here. -->
    <div id="home"><Hero /></div>
    <div id="problem"><Problem /></div>
    <HowItWorks />
    <RuleCheck />
    <Stats />
    <div id="universities"><ForUniversities /></div>
    <FoundingPilot />
    <div id="security"><SecurityTeaser /></div>
    <div id="faq"><FAQ /></div>
    <div id="contact"><CTAFooter /></div>
    <StickyMobileCTA />
  </main>
</Base>
