---
// Palette preview P2 "Petrol Ledger": petrol teal accent, deep blue-green anchor.
// Full mainline page reskinned via :root variable overrides. Unlinked preview;
// delete after the palette pick. Winner must be moved into global.css @theme
// and DESIGN.md's Colour section rewritten in the same commit.
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import AudienceRouter from "../components/AudienceRouter.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
import PilotTerms from "../components/PilotTerms.astro";
import TrustBar from "../components/TrustBar.astro";
import Problem from "../components/Problem.astro";
import Stats from "../components/Stats.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import CaseStudy from "../components/CaseStudy.astro";
import FoundingPilot from "../components/FoundingPilot.astro";
import Screenshots from "../components/Screenshots.astro";
import ForUniversities from "../components/ForUniversities.astro";
import TrustSecurity from "../components/TrustSecurity.astro";
import FAQ from "../components/FAQ.astro";
import CTAFooter from "../components/CTAFooter.astro";
---

<Base title="Palette P2: Petrol Ledger">
  <Navbar />
  <main class="flex-1">
    <div id="home"><Hero /></div>
    <AudienceRouter />
    <TrustBar />
    <div id="problem"><Problem /></div>
    <Stats />
    <HowItWorks />
    <Features />
    <CaseStudy />
    <PilotTerms />
    <FoundingPilot />
    <div id="demo"><Screenshots /></div>
    <div id="universities"><ForUniversities /></div>
    <TrustSecurity />
    <div id="faq"><FAQ /></div>
    <div id="contact"><CTAFooter /></div>
    <StickyMobileCTA />
  </main>
</Base>

<style is:global>
  :root {
    --color-graphite: oklch(0.20 0.028 215);
    --color-graphite-2: oklch(0.17 0.026 215);
    --color-panel: oklch(0.25 0.03 213);
    --color-hairline: oklch(0.33 0.032 212);
    --color-paper: oklch(0.975 0.004 200);
    --color-paper-shade: oklch(0.945 0.006 200);
    --color-line: oklch(0.90 0.007 200);
    --color-ink: oklch(0.215 0.02 220);
    --color-muted: oklch(0.46 0.02 210);
    --color-on-dark: oklch(0.975 0.004 200);
    --color-on-dark-2: oklch(0.80 0.018 205);
    --color-steel: oklch(0.63 0.04 205);
    --color-amber: oklch(0.785 0.105 200);
    --color-amber-hover: oklch(0.73 0.107 199);
    --color-amber-line: oklch(0.66 0.10 200);
    --color-amber-deep: oklch(0.45 0.072 205);
    --color-valid: oklch(0.70 0.14 148);
    --color-valid-deep: oklch(0.42 0.10 147);
    --color-flag: oklch(0.60 0.165 27);
    --color-flag-bright: oklch(0.70 0.155 25);
    --color-flag-deep: oklch(0.45 0.14 27);
  }
</style>
