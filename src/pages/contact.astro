---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import { PLANNER_URL, DEMO_MAILTO, CONTACT_EMAIL, BOOKING_URL, bookDemoHref, INTAKE_URL } from "../config/site";
import CTAButton from "../components/CTAButton.astro";

const blocks = [
  {
    title: "What we cover",
    items: ["Live demo walkthrough", "How we encode your programme rules", "Branding and subdomain setup", "Timeline and effort estimate"],
  },
  {
    title: "What you need",
    items: ["Your MSc programme guide (PDF)", "30 minutes of your time", "No IT department involvement", "No budget commitment upfront"],
  },
];
---

<Base title="Contact / StudyPlanner" description="Get in touch to bring StudyPlanner to your university. Twenty-minute call, no commitment.">
  <Navbar />
  <main class="flex-1">
    <div class="grid-bg min-h-screen bg-paper text-ink">
      <div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
        <div class="mb-8 h-1 w-12 rounded-full bg-accent"></div>
        <h1 class="text-[length:var(--text-display)] font-extrabold tracking-[-0.04em] text-ink">
          Bring StudyPlanner to your university.
        </h1>
        <p class="mt-6 max-w-2xl text-[length:var(--text-lead)] leading-relaxed text-muted">
          Twenty-minute call. We'll walk through the live demo, show how the multi-tenant setup works, and scope what it would take for your programme.
        </p>
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {blocks.map((block) => (
            <div class="rounded-lg border border-line bg-paper-shade p-6">
              <h2 class="mb-4 flex items-center gap-2.5 font-semibold text-ink">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-[1px] bg-accent"></span>
                {block.title}
              </h2>
              <ul class="space-y-2.5">
                {block.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <span class="mt-0.5 shrink-0 text-accent-deep" aria-hidden="true">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {BOOKING_URL && (
          <div class="mt-12 rounded-lg border border-line bg-paper-shade p-6">
            <h2 class="font-semibold text-ink">Book directly</h2>
            <p class="mt-2 text-sm text-muted">Pick a time that works for you. No back-and-forth needed.</p>
            <CTAButton
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              dataTrack="cta-contact-booking"
              class="mt-4"
            >
              Choose a time →
            </CTAButton>
          </div>
        )}

        <div class="mt-12 rounded-lg border border-line bg-paper-shade p-6">
          <h2 class="mb-4 font-semibold text-ink">Send us a message</h2>
          <form id="intake-form" data-intake-url={INTAKE_URL} class="grid gap-4 sm:grid-cols-2">
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              class="hidden"
              aria-hidden="true"
            />
            <div class="sm:col-span-1">
              <label for="name" class="block text-sm font-medium text-muted">Name</label>
              <input id="name" name="name" type="text" required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none" />
            </div>
            <div class="sm:col-span-1">
              <label for="email" class="block text-sm font-medium text-muted">Email</label>
              <input id="email" name="email" type="email" required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none" />
            </div>
            <div class="sm:col-span-1">
              <label for="university" class="block text-sm font-medium text-muted">University</label>
              <input id="university" name="university" type="text" required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none" />
            </div>
            <div class="sm:col-span-1">
              <label for="programme" class="block text-sm font-medium text-muted">Programme</label>
              <input id="programme" name="programme" type="text" required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none" />
            </div>
            <div class="sm:col-span-2">
              <label for="role" class="block text-sm font-medium text-muted">Your role</label>
              <input id="role" name="role" type="text" required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none" />
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="block text-sm font-medium text-muted">Message</label>
              <textarea id="message" name="message" rows="4" required class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2 text-sm text-ink placeholder:text-muted focus:border-accent focus:outline-none"></textarea>
            </div>
            <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
              <button
                type="submit"
                data-track="cta-contact-form-submit"
                class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-sm font-semibold text-graphite transition-colors hover:bg-accent-hover disabled:opacity-60"
              >
                Send message
              </button>
              <p id="intake-status" role="status" aria-live="polite" class="text-sm text-muted"></p>
            </div>
          </form>
        </div>

        <div class="mt-12 flex flex-wrap gap-4">
          <CTAButton href={bookDemoHref} dataTrack="cta-contact-demo">
            Book a 20-min demo
          </CTAButton>
          <CTAButton
            href={PLANNER_URL}
            variant="outline-invert"
            target="_blank"
            rel="noreferrer"
            dataTrack="cta-contact-planner"
          >
            Try the live planner →
          </CTAButton>
        </div>
        <p class="mt-8 text-sm text-muted">
          Or email directly:{" "}
          <a href={DEMO_MAILTO} class="underline decoration-line underline-offset-4 transition-colors hover:text-accent-deep">
            {CONTACT_EMAIL}
          </a>
        </p>
      </div>
    </div>
  </main>

  <script>
    const form = document.getElementById("intake-form") as HTMLFormElement | null;
    const status = document.getElementById("intake-status");
    if (form && status) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const button = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
        const data = new FormData(form);
        const message = [`Programme: ${data.get("programme") ?? ""}`, String(data.get("message") ?? "")]
          .filter(Boolean)
          .join("\n\n");
        if (button) button.disabled = true;
        status.textContent = "Sending…";
        status.className = "text-sm text-muted";
        try {
          const res = await fetch(form.dataset.intakeUrl ?? "", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              org: data.get("university"),
              contactName: data.get("name"),
              email: data.get("email"),
              role: data.get("role"),
              message,
              website: data.get("website"),
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.textContent = "Thanks — we'll reply within two working days.";
          status.className = "text-sm text-accent-deep";
        } catch {
          status.innerHTML =
            'Something went wrong. Please email <a class="underline" href="mailto:alessandro@mscplanner.com">alessandro@mscplanner.com</a> instead.';
          status.className = "text-sm text-muted";
        } finally {
          if (button) button.disabled = false;
        }
      });
    }
  </script>
</Base>
