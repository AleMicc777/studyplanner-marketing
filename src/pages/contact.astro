---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import { PLANNER_URL, DEMO_MAILTO, CONTACT_EMAIL, BOOKING_URL, bookDemoHref } from "../config/site";
import CTAButton from "../components/CTAButton.astro";

const FORMSPREE_ID = import.meta.env.PUBLIC_FORMSPREE_ID ?? null;
const FORMSPREE_ACTION = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : null;

const blocks = [
  {
    title: "What we cover",
    items: ["Live demo walkthrough", "How we encode your programme rules", "Branding and subdomain setup", "Timeline and effort estimate"],
  },
  {
    title: "What you need",
    items: ["Your MSc programme guide (PDF)", "30 minutes of your time", "No IT department involvement", "No budget commitment upfront"],
  },
];
---

<Base title="Contact · StudyPlanner" description="Get in touch to bring StudyPlanner to your university. Twenty-minute call, no commitment.">
  <Navbar />
  <main class="flex-1">
    <div class="grid-bg min-h-screen bg-graphite text-on-dark">
      <div class="mx-auto max-w-3xl px-6 py-24 sm:py-32">
        <div class="mb-8 h-1 w-12 rounded-full bg-amber"></div>
        <h1 class="text-[length:var(--text-display)] font-extrabold tracking-[-0.04em] text-on-dark">
          Bring StudyPlanner to your university.
        </h1>
        <p class="mt-6 max-w-2xl text-[length:var(--text-lead)] leading-relaxed text-on-dark-2">
          Twenty-minute call. We'll walk through the live demo, show how the multi-tenant setup works, and scope what it would take for your programme.
        </p>
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {blocks.map((block) => (
            <div class="rounded-lg border border-hairline bg-panel p-6">
              <h2 class="mb-4 flex items-center gap-2.5 font-semibold text-on-dark">
                <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-[1px] bg-amber"></span>
                {block.title}
              </h2>
              <ul class="space-y-2.5">
                {block.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-on-dark-2">
                    <span class="mt-0.5 shrink-0 text-amber" aria-hidden="true">✓</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {BOOKING_URL && (
          <div class="mt-12 rounded-lg border border-hairline bg-panel p-6">
            <h2 class="font-semibold text-on-dark">Book directly</h2>
            <p class="mt-2 text-sm text-on-dark-2">Pick a time that works for you. No back-and-forth needed.</p>
            <CTAButton
              href={BOOKING_URL}
              target="_blank"
              rel="noreferrer"
              dataTrack="cta-contact-booking"
              class="mt-4"
            >
              Choose a time →
            </CTAButton>
          </div>
        )}

        {FORMSPREE_ACTION && (
          <div class="mt-12 rounded-lg border border-hairline bg-panel p-6">
            <h2 class="mb-4 font-semibold text-on-dark">Send us a message</h2>
            <form action={FORMSPREE_ACTION} method="POST" class="grid gap-4 sm:grid-cols-2">
              <input
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
                class="hidden"
                aria-hidden="true"
              />
              <div class="sm:col-span-1">
                <label for="name" class="block text-sm font-medium text-on-dark-2">Name</label>
                <input id="name" name="name" type="text" required class="mt-1 w-full rounded-md border border-hairline bg-graphite px-3 py-2 text-sm text-on-dark placeholder:text-steel focus:border-amber focus:outline-none" />
              </div>
              <div class="sm:col-span-1">
                <label for="university" class="block text-sm font-medium text-on-dark-2">University</label>
                <input id="university" name="university" type="text" required class="mt-1 w-full rounded-md border border-hairline bg-graphite px-3 py-2 text-sm text-on-dark placeholder:text-steel focus:border-amber focus:outline-none" />
              </div>
              <div class="sm:col-span-1">
                <label for="programme" class="block text-sm font-medium text-on-dark-2">Programme</label>
                <input id="programme" name="programme" type="text" required class="mt-1 w-full rounded-md border border-hairline bg-graphite px-3 py-2 text-sm text-on-dark placeholder:text-steel focus:border-amber focus:outline-none" />
              </div>
              <div class="sm:col-span-1">
                <label for="role" class="block text-sm font-medium text-on-dark-2">Your role</label>
                <input id="role" name="role" type="text" required class="mt-1 w-full rounded-md border border-hairline bg-graphite px-3 py-2 text-sm text-on-dark placeholder:text-steel focus:border-amber focus:outline-none" />
              </div>
              <div class="sm:col-span-2">
                <label for="message" class="block text-sm font-medium text-on-dark-2">Message</label>
                <textarea id="message" name="message" rows="4" required class="mt-1 w-full rounded-md border border-hairline bg-graphite px-3 py-2 text-sm text-on-dark placeholder:text-steel focus:border-amber focus:outline-none"></textarea>
              </div>
              <div class="sm:col-span-2">
                <button
                  type="submit"
                  data-track="cta-contact-form-submit"
                  class="inline-flex items-center justify-center rounded-md bg-amber px-6 py-3 text-sm font-semibold text-graphite transition-colors hover:bg-amber-hover"
                >
                  Send message
                </button>
              </div>
            </form>
          </div>
        )}

        <div class="mt-12 flex flex-wrap gap-4">
          <CTAButton href={bookDemoHref} dataTrack="cta-contact-demo">
            Book a 20-min demo
          </CTAButton>
          <CTAButton
            href={PLANNER_URL}
            variant="outline"
            target="_blank"
            rel="noreferrer"
            dataTrack="cta-contact-planner"
          >
            Try the planner first →
          </CTAButton>
        </div>
        <p class="mt-8 text-sm text-on-dark-2">
          Or email directly:{" "}
          <a href={DEMO_MAILTO} class="underline decoration-hairline underline-offset-4 transition-colors hover:text-amber">
            {CONTACT_EMAIL}
          </a>
        </p>
      </div>
    </div>
  </main>
</Base>
