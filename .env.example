# Cal.com booking link (optional). When set, CTAs link directly to this
# booking page instead of falling back to a mailto: link.
# Example: https://cal.com/your-team/20min
PUBLIC_BOOKING_URL=

# Formspree form ID (optional). When set, the contact page renders a
# Formspree-backed contact form in addition to the mailto fallback.
# Example: xzbqkdwl
PUBLIC_FORMSPREE_ID=
